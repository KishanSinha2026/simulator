DATABASE_URL=postgresql+psycopg://replace-user:replace-with-db-password@localhost:5432/tenable
# GET /rest/scanResult reads here; for the demo, point to the same database as DATABASE_URL.
TENABLE_DATABASE_URL=postgresql+psycopg://replace-user:replace-with-db-password@localhost:5432/tenable
# DATA=DB reads fixture rows from PostgreSQL. DATA=API proxies to the vendor services below.
DATA=DB
API_BASE_URL=http://localhost:8000
# Client-facing API URLs (clients call these; they are not database URLs).
TENABLE_BASE_URL=http://localhost:8000
CMDB_BASE_URL=http://localhost:8000
# Configure on the server and the calling client; send only through x-apikey
# in the Tenable-compatible request, never in a URL or query parameter.
TENABLE_ACCESS_KEY=replace-with-access-key
TENABLE_SECRET_KEY=replace-with-secret-key
# Set only when DATA=API; use the upstream Tenable Security Center server URL.
TENABLE_SOURCE_URL=
# Source paths from BRD; validate verbs, paging, and response formats with the client.
TENABLE_SCAN_RESULTS_PATH=/rest/scanResult
TENABLE_ANALYSIS_PATH=/rest/analysis
CMDB_DATABASE_URL=postgresql+psycopg://vpm360:replace-db-password@localhost:5432/cmdb
# Set only when DATA=API; use the upstream BMC CMDB server URL.
CMDB_SOURCE_URL=
CMDB_DATASET_ID=BMC.ASSET
# Separate CMDB demo login; clients POST these to /api/jwt/login for an AR-JWT.
CMDB_USERNAME=demo
CMDB_PASSWORD=demo
# Server-side token signing secret; never put this value in a client request.
CMDB_JWT_SECRET=replace-with-a-long-random-signing-secret

