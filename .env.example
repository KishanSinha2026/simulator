# Copy to .env for local development. Keep real credentials in .env or a secret
# manager; never commit them. Each provider accepts "json" or "api".

# -----------------------------------------------------------------------------
# Application and PostgreSQL
# -----------------------------------------------------------------------------
APP_NAME=VPM360 Simulator
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501

# Local PostgreSQL example. Replace with the database URL for your environment.
DATABASE_URL=postgresql+psycopg://appuser:ChangeMe13_Strong@localhost:5433/appdb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Shared connector settings
# -----------------------------------------------------------------------------
FIXTURE_DIR=fixtures
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Tenable vulnerability management
# -----------------------------------------------------------------------------
TENABLE_PROVIDER=json
# Set to api after supplying the Tenable Security Center base URL and API keys.
# TENABLE_PROVIDER=api
TENABLE_BASE_URL=
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
TENABLE_VERIFY_TLS=true

# Nessus API routes; override these when using Tenable Security Center.
TENABLE_SCAN_RESULT_PATH=/scans
TENABLE_ANALYSIS_PATH=/scans/{scan_id}
TENABLE_SCAN_RESULT_FIELDS=id,name,description,status,details,resultType,startTime,finishtime,scanduration,repository
TENABLE_SCAN_RESULT_METHOD=GET
TENABLE_ANALYSIS_METHOD=GET
TENABLE_AUTH_HEADER_NAME=X-ApiKeys
TENABLE_AUTH_HEADER_PREFIX=
TENABLE_ANALYSIS_ID_PARAM=scanID
TENABLE_ANALYSIS_ID_LOCATION=path
TENABLE_SCAN_RESULT_PAGING_MODE=none
# Used only with TENABLE_SCAN_RESULT_PAGING_MODE=offset_limit.
TENABLE_SCAN_RESULT_OFFSET_PARAM=
TENABLE_SCAN_RESULT_LIMIT_PARAM=

# -----------------------------------------------------------------------------
# BMC Helix CMDB
# -----------------------------------------------------------------------------
CMDB_PROVIDER=json
# Change to api after providing the Helix CMDB URL, credentials, and dataset.
# CMDB_PROVIDER=api
CMDB_BASE_URL=
CMDB_USERNAME=
CMDB_PASSWORD=
CMDB_VERIFY_TLS=true
CMDB_DATASET_ID=
CMDB_NAMESPACE=BMC.CORE
CMDB_SERVER_CLASS=BMC_ComputerSystem
CMDB_IP_ENDPOINT_CLASS=BMC_IPEndpoint
# The BRD does not specify these custom class names; obtain them from the CMDB team.
CMDB_MIDDLEWARE_CLASS=
CMDB_DATABASE_CLASS=
CMDB_RELATIONSHIP_CLASS=

# CMDB writeback remains disabled until class, attributes, permissions, and timing
# are approved by the client.
CMDB_WRITEBACK_ENABLED=false
CMDB_WRITEBACK_DATASET_ID=
CMDB_WRITEBACK_NAMESPACE=
CMDB_WRITEBACK_CLASS_NAME=
CMDB_OS_VERSION_ATTRIBUTE=
CMDB_LAST_PATCH_ATTRIBUTE=

# -----------------------------------------------------------------------------
# BMC Helix ITSM 26.1 (ticketing and change workflow)
# -----------------------------------------------------------------------------
ITSM_PROVIDER=json
# Change to api after providing the Helix ITSM base URL and credentials.
# ITSM_PROVIDER=api
ITSM_BASE_URL=
ITSM_USERNAME=
ITSM_PASSWORD=
ITSM_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# Red Hat Satellite 6.9 (Linux patch orchestration)
# -----------------------------------------------------------------------------
# SATELLITE_PROVIDER=json
# Change to api after providing the Satellite server URL and credentials.
# SATELLITE_PROVIDER=api
SATELLITE_BASE_URL=
SATELLITE_USERNAME=
SATELLITE_PASSWORD=
SATELLITE_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# SCCM 2509 / Configuration Manager (Windows inventory and patching)
# -----------------------------------------------------------------------------
SCCM_PROVIDER=json
# Change to api after configuring the approved AdminService endpoint and credentials.
# SCCM_PROVIDER=api
SCCM_BASE_URL=
SCCM_USERNAME=
SCCM_PASSWORD=
SCCM_SITE_CODE=P01
SCCM_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# Ansible Automation Controller 4.2 / AAP / AWX
# -----------------------------------------------------------------------------
ANSIBLE_PROVIDER=api
ANSIBLE_BASE_URL=
# Keep the prefix matching the controller deployment. The current sandbox uses
# /api/controller/v2; older AWX/controller installs may use /api/v2.
ANSIBLE_API_PREFIX=/api/controller/v2
ANSIBLE_API_KEY=
ANSIBLE_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# Squad1 vulnerability lifecycle
# -----------------------------------------------------------------------------
SQUAD1_PROVIDER=json
# Change to api after receiving the Squad1 import URL and API key.
# SQUAD1_PROVIDER=api
SQUAD1_BASE_URL=
SQUAD1_API_KEY=
SQUAD1_VERIFY_TLS=true
