# Tenable
# Base URL supplied in the BRD. Confirm the reachable client environment.
TENABLE_BASE_URL=https://10.24.112.34

# Supply through .env or an approved secret manager; never commit credentials.
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
TENABLE_VERIFY_TLS=true

# BRD routes. Keep these paths unless the client confirms otherwise.
TENABLE_SCAN_RESULT_PATH=/rest/scanResult
TENABLE_ANALYSIS_PATH=/rest/analysis

# Fields supplied in the BRD scanResult example.
TENABLE_SCAN_RESULT_FIELDS=id,name,description,status,details,resultType,startTime,finishtime,scanduration,repository

# These must be set only after confirming the installed client API contract.
# Allowed HTTP methods: GET or POST.
# TENABLE_SCAN_RESULT_METHOD=
# TENABLE_ANALYSIS_METHOD=

# Header name and optional prefix are client-specific.
# For example, do not assume X-ApiKeys unless the client confirms it.
# TENABLE_AUTH_HEADER_NAME=
# TENABLE_AUTH_HEADER_PREFIX=

# The actual analysis ID parameter and where it belongs are client-specific.
# TENABLE_ANALYSIS_ID_PARAM=
# TENABLE_ANALYSIS_ID_LOCATION=query

# Set "none" only after confirming that scanResult returns all records.
# Otherwise use the confirmed offset/limit paging scheme.
# TENABLE_SCAN_RESULT_PAGING_MODE=none
# TENABLE_SCAN_RESULT_OFFSET_PARAM=
# TENABLE_SCAN_RESULT_LIMIT_PARAM=

TENABLE_SCAN_RESULT_PAGE_SIZE=100
TENABLE_MAX_SCAN_RESULTS=10000