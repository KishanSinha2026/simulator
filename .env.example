
# Application
APP_NAME=VPM360 Simulator
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://appuser:replace_me@localhost:5432/vpm_simulator
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Integration provider: json or api
TENABLE_PROVIDER=json
CMDB_PROVIDER=json
ITSM_PROVIDER=json
SATELLITE_PROVIDER=json

# JSON fixture directory
FIXTURE_DIR=fixtures

# HTTP client defaults
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3

# Tenable
TENABLE_BASE_URL=
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
TENABLE_VERIFY_TLS=true

# BMC Helix CMDB
CMDB_BASE_URL=
CMDB_USERNAME=
CMDB_PASSWORD=
CMDB_VERIFY_TLS=true

# BMC Helix ITSM
ITSM_BASE_URL=
ITSM_USERNAME=
ITSM_PASSWORD=
ITSM_VERIFY_TLS=true

# Red Hat Satellite 6.9
SATELLITE_BASE_URL=
SATELLITE_USERNAME=
SATELLITE_PASSWORD=
SATELLITE_VERIFY_TLS=true
